{
  "name": "simkodes-e2e-automation",
  "version": "1.0.0",
  "description": "Enterprise Playwright E2E Automation Framework for SIMKODES ERP & Public Service Platform",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:staging": "BASE_URL=https://simkodes-staging.sranak.com playwright test",
    "report": "playwright show-report"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "e2e",
    "testing",
    "page-object-model",
    "devops"
  ],
  "author": "Muhamad Rofii",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
